NODE_ENV=development
PORT=5005

# Database (shared MySQL instance)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_search_db
DB_USER=root
DB_PASSWORD=your_password

# JWT — MUST match the auth-service JWT_ACCESS_SECRET exactly
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here

# File Storage
# Absolute or relative path to the directory where user uploads are stored.
# A sub-folder per user is created automatically: UPLOAD_DIR/<userId>/
UPLOAD_DIR=uploads

# Maximum file size per upload in megabytes (default: 10)
MAX_FILE_SIZE_MB=10

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: restrict allowed MIME types (comma-separated)
# Leave blank to use the service defaults (images, PDFs, docs, videos)
# ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
