NODE_ENV=development
PORT=5001
LOG_LEVEL=info
# Apply pending migrations at startup (otherwise run: npm run migrate)
MIGRATE_ON_START=true
# Proxy hops in front of this service (the API gateway = 1)
TRUST_PROXY=1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_search_db
DB_USER=root
DB_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (RS256). Provide the key pair as PEM strings or file paths. Never commit keys.
# Development: run `npm run keys:generate` (writes git-ignored services/keys/), or leave
# these empty and keys are generated there on first start. Production: required.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ISSUER=ai-search-auth
JWT_AUDIENCE=ai-search
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email: "mailgun" sends; "log" only logs recipient + subject (development/tests).
# In log mode read OTPs from Redis: redis-cli get otp:<email>
MAIL_TRANSPORT=log
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=no-reply@keepmystore.com

# Google OAuth — the callback goes through the gateway
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Frontend URL (for redirects and email links)
FRONTEND_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Shared secret other services send as X-Internal-Token for internal endpoints
# (e.g. POST /auth/notifications). Required (32+ chars) in production.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# Secret for encrypting agent API keys (only needed if the agents module is used)
KEY_SECRET=

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
