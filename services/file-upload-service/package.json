{
  "name": "@ai-search/file-upload-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx src/scripts/migrate.ts",
    "typecheck": "tsc -p test",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "@ai-search/platform": "*",
    "@ai-search/shared-auth": "*",
    "dotenv": "^16.3.1",
    "envalid": "^8.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "multer": "^2.4.0",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.1",
    "uuid": "^9.0.0"
  }
}
