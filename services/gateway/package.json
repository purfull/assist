{
  "name": "@ai-search/gateway",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p test",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "test:coverage": "NODE_ENV=test node --import tsx --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='../**' --test-coverage-lines=97 --test-coverage-branches=80 --test-coverage-functions=97 test/*.test.ts"
  },
  "dependencies": {
    "@ai-search/platform": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "envalid": "^8.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {}
}
