NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Upstream services (internal addresses; they must not be publicly reachable)
AUTH_SERVICE_URL=http://localhost:5001
FILE_UPLOAD_SERVICE_URL=http://localhost:5005

# Comma-separated browser origins allowed by CORS (the gateway is the only CORS owner)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Proxy hops in front of the gateway (e.g. 1 behind a cloud load balancer; 0 = none)
TRUST_PROXY=0

# Edge limits
RATE_LIMIT_PER_MINUTE=300
PROXY_TIMEOUT_MS=30000
