NODE_ENV=development
PORT=5005
LOG_LEVEL=info
# Apply pending migrations at startup (otherwise run: npm run migrate)
MIGRATE_ON_START=true
# Proxy hops in front of this service (the API gateway = 1)
TRUST_PROXY=1

# Database (shared MySQL instance; this service owns only file_records)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_search_db
DB_USER=root
DB_PASSWORD=your_password

# JWT verification. Preferred: fetch keys from auth-service's JWKS endpoint.
JWT_JWKS_URL=http://localhost:5001/auth/.well-known/jwks.json
# Alternatives: the auth-service public key as a PEM string or file path
# JWT_PUBLIC_KEY_PATH=../keys/public.pem
JWT_ISSUER=ai-search-auth
JWT_AUDIENCE=ai-search

# File Storage
# Absolute or relative path to the directory where user uploads are stored.
# A sub-folder per user is created automatically: UPLOAD_DIR/<userId>/
UPLOAD_DIR=uploads

# Maximum file size per upload in megabytes (default: 10)
MAX_FILE_SIZE_MB=10

# Optional: restrict allowed MIME types (comma-separated)
# Leave blank to use the service defaults (images, PDFs, docs, video, audio, zip; no SVG)
# ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
